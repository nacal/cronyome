{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "extends": ["@nacal-tools/biome-config/biome.json"],
  "files": {
    "includes": ["**", "!**/dist", "!**/coverage", "!demo/cronyome.mjs"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off"
      },
      "security": {
        "noSecrets": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ]
}
