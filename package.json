{
  "name": "cronyome",
  "version": "0.1.1",
  "description": "cron 式を自然な日本語に変換するライブラリ",
  "keywords": [
    "cron",
    "crontab",
    "japanese",
    "i18n",
    "humanize",
    "describe"
  ],
  "license": "MIT",
  "author": "nacal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nacal/cronyome.git"
  },
  "homepage": "https://github.com/nacal/cronyome#readme",
  "bugs": "https://github.com/nacal/cronyome/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.mts",
        "default": "./dist/internal.mjs"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "tsdown",
    "build:demo": "vite build --config demo/vite.config.ts",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "describe": "pnpm -s build && node -e \"const{describe}=await import('./dist/index.mjs');for(const e of process.argv.slice(1)){const r=describe(e);console.log(e.padEnd(20),'|',r.short.padEnd(28),'|',r.long)}\" --",
    "size": "size-limit",
    "check:publish": "pnpm build && publint && attw --pack . --profile node16",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:publish && pnpm size",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "demo": "vite --config demo/vite.config.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.8",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^3.0.0",
    "@nacal-tools/biome-config": "^0.2.2",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "croner": "^10.0.1",
    "hono": "^4.13.1",
    "publint": "^0.3.23",
    "size-limit": "^13.0.3",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "name": "cronyome (ESM, brotli)",
      "path": "dist/index.mjs",
      "limit": "6 kB"
    }
  ],
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.32.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
